# Kirby core (installed via Composer)
/kirby
/vendor

# Composer
/composer.phar

# Local config / secrets
/site/config/config.localhost.php
/site/accounts/*
!/site/accounts/.gitkeep
/site/sessions
/site/cache
/site/logs

# Media cache (Kirby regenerates)
/media

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Editor noise
.idea/
.vscode/
*.swp
*.swo
*~

# Claude Code session state (worktrees, local settings)
.claude/

# Node (none in this project — keep ignored just in case)
node_modules/
dist/

# Legacy app's local files (Replit-era build artefacts left in the root)
/legacy/node_modules
/legacy/dist
/legacy/.local
/legacy/.config
/dist
/public
/node_modules

# Replit-era user-level dirs that shouldn't be tracked
/.config
/.local

# Video files kept locally only — the 2020 Winter Festival .mp4 is >250MB
# and goes to YouTube per the deferred social-setup plan, so we don't push
# raw video blobs to git. Pre-published Vimeo/YouTube URLs go in content/.
/content/**/*.mp4
/content/**/*.mov
/content/**/*.m4v
/content/**/*.webm

# Review-phase Basic Auth file (deployed via zip only)
/.htpasswd
